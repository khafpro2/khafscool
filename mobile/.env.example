# Exemple de configuration — application Expo (mobile/)
# Déclarer dans eas.json (profils preview / production) ou secrets EAS :
#   eas secret:create --name EXPO_PUBLIC_API_URL --value https://api.votredomaine.com
# Voir DEPLOYMENT.md pour EAS Build.

# --- API (obligatoire sur appareil physique) ---
# URL publique du backend. localhost ne fonctionne pas sur téléphone — utiliser l’IP LAN en dev.
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Web (liens profil, certificats, quêtes) ---
# URL du front Next.js déployé (Vercel).
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# --- Contact HarmyTech (optionnel) ---
# Email officiel pour support et demandes RGPD. Défaut : KTHIAM@HARMYTECH.COM
EXPO_PUBLIC_CONTACT_EMAIL=KTHIAM@HARMYTECH.COM

# --- Virement bancaire (optionnel) — coordonnées SEPA sur l’écran À propos ---
EXPO_PUBLIC_DONATION_BANK_BENEFICIARY=
EXPO_PUBLIC_DONATION_BANK_IBAN=
EXPO_PUBLIC_DONATION_BANK_BIC=
EXPO_PUBLIC_DONATION_BANK_NAME=
EXPO_PUBLIC_DONATION_BANK_ADDRESS=
EXPO_PUBLIC_DONATION_BANK_CORRESPONDENT_BIC=
EXPO_PUBLIC_DONATION_BANK_REFERENCE=
