# Exemple de configuration — monorepo (développement local)
# Copier vers .env à la racine : cp .env.example .env
#
# Fichiers par service (alignés DEPLOYMENT.md) :
#   backend/.env.example  — API, JWT, OAuth, Stripe, CORS
#   web/.env.example      — NEXT_PUBLIC_API_URL, WEB_URL
#   mobile/.env.example   — EXPO_PUBLIC_API_URL, EXPO_PUBLIC_WEB_URL
#
# OAuth production : docs/OAUTH-PRODUCTION.md

# --- Base de données (obligatoire) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/apple_mdm_academy
# Postgres Docker : hôte 5433 → conteneur 5432 (voir compose.yaml). Toujours le port hôte dans DATABASE_URL.
# Si vous mappez 5432:5432 dans compose.yaml :
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apple_mdm_academy

# --- JWT (obligatoire en production) ---
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# --- URLs publiques ---
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://127.0.0.1:3000
MOBILE_REDIRECT_URI=applemdmacademy://auth

# --- Contact HarmyTech (optionnel) ---
# Email officiel pour support et demandes RGPD. Défaut : KTHIAM@HARMYTECH.COM
CONTACT_EMAIL=KTHIAM@HARMYTECH.COM
NEXT_PUBLIC_CONTACT_EMAIL=KTHIAM@HARMYTECH.COM

# --- CORS (recommandé en production) ---
# Origines autorisées, séparées par des virgules. Laisser vide = tout autoriser (dev uniquement).
CORS_ORIGIN=

# --- OAuth Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- OAuth Apple ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/auth/apple/callback

# --- OAuth Microsoft ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback

# --- Facturation Stripe (optionnel) ---
# Laisser STRIPE_SECRET_KEY vide pour le mode démo (URL fictive, badge « Mode démo »).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_PRICE_ID_ENTERPRISE=

# --- Dons volontaires (optionnel) — voir docs/DONATIONS.md ---
STRIPE_DONATION_PRICE_ID_5=
STRIPE_DONATION_PRICE_ID_10=
STRIPE_DONATION_PRICE_ID_20=
DONATION_URL=

# --- PayPal (optionnel) — lien Donate ou PayPal.Me — voir docs/DONATIONS.md ---
# Défaut intégré : https://www.paypal.com/paypalme/khafpro — laisser vide pour conserver ce lien.
# Ex. override : https://www.paypal.com/donate/?hosted_button_id=XXXX
DONATION_PAYPAL_URL=
NEXT_PUBLIC_DONATION_PAYPAL_URL=
EXPO_PUBLIC_DONATION_PAYPAL_URL=

# --- Virement bancaire (optionnel) — coordonnées publiques pour dons SEPA ---
# Défauts HarmyTech / Revolut — voir docs/DONATIONS.md
DONATION_BANK_BENEFICIARY=
DONATION_BANK_IBAN=
DONATION_BANK_BIC=
DONATION_BANK_NAME=
DONATION_BANK_ADDRESS=
DONATION_BANK_CORRESPONDENT_BIC=
DONATION_BANK_REFERENCE=
NEXT_PUBLIC_DONATION_BANK_BENEFICIARY=
NEXT_PUBLIC_DONATION_BANK_IBAN=
NEXT_PUBLIC_DONATION_BANK_BIC=
NEXT_PUBLIC_DONATION_BANK_NAME=
NEXT_PUBLIC_DONATION_BANK_ADDRESS=
NEXT_PUBLIC_DONATION_BANK_CORRESPONDENT_BIC=
NEXT_PUBLIC_DONATION_BANK_REFERENCE=
EXPO_PUBLIC_DONATION_BANK_BENEFICIARY=
EXPO_PUBLIC_DONATION_BANK_IBAN=
EXPO_PUBLIC_DONATION_BANK_BIC=
EXPO_PUBLIC_DONATION_BANK_NAME=
EXPO_PUBLIC_DONATION_BANK_ADDRESS=
EXPO_PUBLIC_DONATION_BANK_CORRESPONDENT_BIC=
EXPO_PUBLIC_DONATION_BANK_REFERENCE=

# --- Admin (statistiques dons, lecture seule) ---
ADMIN_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
