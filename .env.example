# Exemple de configuration — monorepo (développement local)
# Copier vers .env à la racine : cp .env.example .env
#
# Fichiers par service (alignés DEPLOYMENT.md) :
#   backend/.env.example  — API, JWT, OAuth, Stripe, CORS
#   web/.env.example      — NEXT_PUBLIC_API_URL, WEB_URL
#   mobile/.env.example   — EXPO_PUBLIC_API_URL, EXPO_PUBLIC_WEB_URL
#
# OAuth production : docs/OAUTH-PRODUCTION.md

# --- Base de données (obligatoire) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apple_mdm_academy
# Si le port 5432 est déjà pris en local, mappez 5433:5432 dans compose.yaml et utilisez :
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/apple_mdm_academy

# --- JWT (obligatoire en production) ---
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# --- URLs publiques ---
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://127.0.0.1:3000
MOBILE_REDIRECT_URI=applemdmacademy://auth

# --- Contact HarmyTech (optionnel) ---
# Email officiel pour support et demandes RGPD. Défaut : KTHIAM@HARMYTECH.COM
CONTACT_EMAIL=KTHIAM@HARMYTECH.COM
NEXT_PUBLIC_CONTACT_EMAIL=KTHIAM@HARMYTECH.COM

# --- CORS (recommandé en production) ---
# Origines autorisées, séparées par des virgules. Laisser vide = tout autoriser (dev uniquement).
CORS_ORIGIN=

# --- OAuth Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- OAuth Apple ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/auth/apple/callback

# --- OAuth Microsoft ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback

# --- Facturation Stripe (optionnel) ---
# Laisser STRIPE_SECRET_KEY vide pour le mode démo (URL fictive, badge « Mode démo »).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_PRICE_ID_ENTERPRISE=

# --- Dons volontaires (optionnel) — voir docs/DONATIONS.md ---
STRIPE_DONATION_PRICE_ID_5=
STRIPE_DONATION_PRICE_ID_10=
STRIPE_DONATION_PRICE_ID_20=
DONATION_URL=

# --- Admin (statistiques dons, lecture seule) ---
ADMIN_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
