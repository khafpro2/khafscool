# Exemple de configuration — application Next.js (web/)
# Copier vers web/.env.local ou définir dans Vercel → Project Settings → Environment Variables.
# Voir DEPLOYMENT.md pour le déploiement production.

# --- API (obligatoire hors mode démo) ---
# URL publique du backend Fastify. Sans slash final.
# Dev local : http://localhost:4000
# Production : https://api.votredomaine.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- SEO et métadonnées (optionnel) ---
# URL canonique du site (sitemap, robots, Open Graph). Utilisée au build.
# Dev local : http://127.0.0.1:3000
# Production : https://app.votredomaine.com
WEB_URL=http://127.0.0.1:3000

# --- Contact HarmyTech (optionnel) ---
# Email officiel pour support et demandes RGPD. Défaut : KTHIAM@HARMYTECH.COM
CONTACT_EMAIL=KTHIAM@HARMYTECH.COM
NEXT_PUBLIC_CONTACT_EMAIL=KTHIAM@HARMYTECH.COM

# --- Virement bancaire (optionnel) — override des coordonnées SEPA affichées sur /soutenir ---
# Laisser vide = valeurs par défaut HarmyTech / Revolut (voir docs/DONATIONS.md)
NEXT_PUBLIC_DONATION_BANK_BENEFICIARY=
NEXT_PUBLIC_DONATION_BANK_IBAN=
NEXT_PUBLIC_DONATION_BANK_BIC=
NEXT_PUBLIC_DONATION_BANK_NAME=
NEXT_PUBLIC_DONATION_BANK_ADDRESS=
NEXT_PUBLIC_DONATION_BANK_CORRESPONDENT_BIC=
NEXT_PUBLIC_DONATION_BANK_REFERENCE=
