# Exemple de configuration — API Fastify (backend/)
# Copier vers backend/.env ou utiliser le .env à la racine du monorepo en dev local.
# Voir DEPLOYMENT.md et docs/OAUTH-PRODUCTION.md pour la production.

# --- Base de données (obligatoire) ---
# Chaîne PostgreSQL. En local : docker compose mappe l’hôte 5433 → conteneur 5432 (voir compose.yaml).
# Toujours utiliser le port HÔTE (5433) dans DATABASE_URL, jamais le port interne du conteneur.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/apple_mdm_academy
# Si vous mappez 5432:5432 dans compose.yaml (sans conflit local) :
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apple_mdm_academy

# --- JWT (obligatoire en production) ---
# Secrets longs et aléatoires (≥ 32 caractères). Ne jamais réutiliser entre environnements.
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# --- Serveur ---
# Port d’écoute (souvent imposé par Railway / Render / Fly.io).
PORT=4000
# URL publique de l’API (callbacks OAuth, liens absolus). Sans slash final.
API_URL=http://localhost:4000

# --- CORS (recommandé en production) ---
# Origines autorisées, séparées par des virgules. Laisser vide = tout autoriser (dev uniquement).
CORS_ORIGIN=

# --- Mobile OAuth (deep link Expo) ---
# URI de retour après SSO mobile : scheme défini dans app.json.
MOBILE_REDIRECT_URI=applemdmacademy://auth

# --- OAuth Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- OAuth Apple ---
APPLE_CLIENT_ID=
# Identifiants Apple Developer (Sign in with Apple — clé .p8 côté serveur en prod).
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Clé privée .p8 sur une seule ligne avec \n échappés, ou multiligne selon hébergeur.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/auth/apple/callback

# --- OAuth Microsoft ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback

# --- Facturation Stripe (optionnel) ---
# Laisser STRIPE_SECRET_KEY vide pour le mode démo (checkout simulé, badge « Mode démo »).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_PRICE_ID_ENTERPRISE=

# --- Dons volontaires (optionnel) ---
# Voir docs/DONATIONS.md pour la configuration Stripe Dashboard et le webhook local.
STRIPE_DONATION_PRICE_ID_5=
STRIPE_DONATION_PRICE_ID_10=
STRIPE_DONATION_PRICE_ID_20=
DONATION_URL=

# --- PayPal (optionnel) — voir docs/DONATIONS.md ---
# Défaut intégré : https://www.paypal.com/paypalme/khafpro — laisser vide pour conserver ce lien.
DONATION_PAYPAL_URL=

# --- Admin (statistiques dons, lecture seule) ---
# GET /admin/donations/stats — en-tête X-Admin-Api-Key
ADMIN_API_KEY=
WEB_URL=http://127.0.0.1:3000
